# Copie este arquivo para ".env" e preencha com os dados do seu projeto Supabase
# (Project Settings > API, no painel do supabase.com).
#
# Essas variáveis começam com EXPO_PUBLIC_ porque o Expo as inclui no app do celular
# (a "anon key" do Supabase é feita para ser pública — a segurança real vem das
# políticas de Row Level Security criadas pelas migrations em supabase/migrations).

EXPO_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key-aqui
